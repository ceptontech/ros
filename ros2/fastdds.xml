<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <!-- Shared memory for processes on the same host. -->
      <transport_descriptor>
        <transport_id>shm_big</transport_id>
        <type>SHM</type>
        <segment_size>268435456</segment_size> <!-- 256 MiB -->
        <maxMessageSize>4194304</maxMessageSize> <!-- 4 MiB -->
        <port_queue_capacity>4096</port_queue_capacity>
      </transport_descriptor>

      <!-- UDP remains enabled for nodes on other hosts. -->
      <transport_descriptor>
        <transport_id>udp_default</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="big_shm_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_big</transport_id>
          <transport_id>udp_default</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
